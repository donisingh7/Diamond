# Use an explicit database name and a transaction-capable replica set or Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/diamond_dev?replicaSet=rs0
# Optional comma-separated DNS IPs if your resolver cannot resolve Atlas SRV.
# Changes Node DNS for this server process; blank uses system DNS.
MONGODB_DNS_SERVERS=
# Required for OTP hashing/session-related secret operations; generate locally.
SESSION_SECRET=
SEED_ADMIN_LOGIN_ID=
SEED_ADMIN_PASSWORD=

# --- Guarded demo deployment seed (scripts/seed-demo.ts, `npm run db:seed-demo`) --------------
# Does NOT run on app startup. Set DEMO_SEED_ENABLED=true to allow it, and supply the demo
# passwords below. Placeholders only here — never commit real values.
DEMO_SEED_ENABLED=
DEMO_PLAYER_PHONE=
DEMO_PLAYER_PASSWORD=
DEMO_ADMIN_DONI_PASSWORD=
DEMO_ADMIN_PANKAJ_PASSWORD=
DEMO_ADMIN_GOPAL_PASSWORD=
