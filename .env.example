# Use an explicit database name and a transaction-capable replica set or Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/diamond_dev?replicaSet=rs0
# Optional comma-separated DNS IPs if your resolver cannot resolve Atlas SRV.
# Changes Node DNS for this server process; blank uses system DNS.
MONGODB_DNS_SERVERS=
# Required for OTP hashing/session-related secret operations; generate locally.
SESSION_SECRET=
SEED_ADMIN_LOGIN_ID=
SEED_ADMIN_PASSWORD=
